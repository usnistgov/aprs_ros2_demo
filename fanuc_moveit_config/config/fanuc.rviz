        - /Global Options1
        - /Status1
        - /TF1/Frames1
      Splitter Ratio: 0.5
    Tree Height: 853
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
